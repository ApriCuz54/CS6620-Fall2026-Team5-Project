# Local smoke-test service based on the provided scanner, not the production job worker.
FROM node:24-bookworm-slim
WORKDIR /app
COPY sast/backend/package.json sast/backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=node:node sast/backend/scanner.js sast/backend/server.js ./
USER node
ENV NODE_ENV=production PORT=3000
EXPOSE 3000
CMD ["node", "server.js"]
